# GENERATED by scripts/generate_matrix_ttl.py from sources/bpmn-connection-rules.json
# (BPMN 2.0.2, formal/13-12-09, Tables 7.3 and 7.4). Do not edit by hand.

# The matrix vocabulary. Not part of the OMG metamodel.
bpmn:ConnectionRule a owl:Class ;
    rdfs:label "Connection rule"@en, "Verbindingsregel"@nl ;
    rdfs:comment "One cell of the BPMN connection tables, spelled out over metamodel classes: may a flow of this type run from this kind of element to that kind?"@en .
bpmn:flowType a owl:ObjectProperty ; rdfs:label "flow type"@en ; rdfs:domain bpmn:ConnectionRule .
bpmn:sourceType a owl:ObjectProperty ; rdfs:label "source type"@en ; rdfs:domain bpmn:ConnectionRule .
bpmn:targetType a owl:ObjectProperty ; rdfs:label "target type"@en ; rdfs:domain bpmn:ConnectionRule .
bpmn:sourceTrigger a owl:ObjectProperty ; rdfs:label "source trigger"@en ;
    rdfs:comment "The event definition the source must carry, for the message events of Table 7.4."@en .
bpmn:targetTrigger a owl:ObjectProperty ; rdfs:label "target trigger"@en .
bpmn:permitted a owl:DatatypeProperty ; rdfs:label "permitted"@en, "toegestaan"@nl ; rdfs:range xsd:boolean .
bpmn:specCell a owl:DatatypeProperty ; rdfs:label "specification cell"@en ;
    rdfs:comment "Where this cell is printed in the specification."@en .


