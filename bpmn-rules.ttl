@prefix bpmn: <https://w3id.org/bpmn#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix bpmnsh: <https://w3id.org/bpmn/shapes#> .

# GENERATED by scripts/generate_matrix_ttl.py: the normative sentences of BPMN 2.0.2
# about connections, each with the shape that checks it. Do not edit by hand;
# the coverage is kept in scripts/coverage.py.

bpmn:NormativeStatement a owl:Class ;
    rdfs:label "Normative statement"@en, "Normatieve uitspraak"@nl ;
    rdfs:comment "A sentence from the BPMN specification that constrains models, quoted verbatim with its clause and page."@en .
bpmn:checkedBy a owl:ObjectProperty ; rdfs:label "checked by"@en ; rdfs:domain bpmn:NormativeStatement .
bpmn:notCheckedBecause a owl:DatatypeProperty ; rdfs:label "not checked because"@en .
bpmn:clause a owl:DatatypeProperty ; rdfs:label "clause"@en .
bpmn:page a owl:DatatypeProperty ; rdfs:label "page"@en .
bpmn:verbatim a owl:DatatypeProperty ; rdfs:label "verbatim text"@en .

bpmn:statement-01 a bpmn:NormativeStatement ;
    bpmn:clause "7.6"@en ;
    bpmn:page "40"@en ;
    bpmn:verbatim "An incoming Sequence Flow can connect to any location on a Flow Object (left, right, top, or bottom). Likewise, an outgoing Sequence Flow can connect from any location on a Flow Object (left, right, top, or bottom). A Message Flow also has this capability."@en ;
    dct:source <https://www.omg.org/spec/BPMN/2.0.2/PDF> ;
    bpmn:notCheckedBecause "Depends on where a shape sits in the diagram (diagram interchange), which stays in the XML."@en .

bpmn:statement-02 a bpmn:NormativeStatement ;
    bpmn:clause "7.6.1"@en ;
    bpmn:page "40"@en ;
    bpmn:verbatim "These rules apply to the connections within a Process Diagram and within a Choreography Diagram."@en ;
    dct:source <https://www.omg.org/spec/BPMN/2.0.2/PDF> ;
    bpmn:notCheckedBecause "Scope statement: says where the rules apply, constrains nothing."@en .

bpmn:statement-03 a bpmn:NormativeStatement ;
    bpmn:clause "7.6.1"@en ;
    bpmn:page "40"@en ;
    bpmn:verbatim "Note that if a Sub-Process has been expanded within a Diagram, the objects within the Sub-Process cannot be connected to objects outside of the Sub-Process, nor can Sequence Flows cross a Pool boundary."@en ;
    dct:source <https://www.omg.org/spec/BPMN/2.0.2/PDF> ;
    bpmn:checkedBy bpmnsh:SequenceFlowContainerShape .

bpmn:statement-04 a bpmn:NormativeStatement ;
    bpmn:clause "7.6.2"@en ;
    bpmn:page "41"@en ;
    bpmn:verbatim "These rules apply to the connections within a Collaboration Diagram."@en ;
    dct:source <https://www.omg.org/spec/BPMN/2.0.2/PDF> ;
    bpmn:notCheckedBecause "Scope statement: says where the rules apply, constrains nothing."@en .

bpmn:statement-05 a bpmn:NormativeStatement ;
    bpmn:clause "7.6.2"@en ;
    bpmn:page "41"@en ;
    bpmn:verbatim "Note that Message Flows cannot connect to objects that are within the same Pool."@en ;
    dct:source <https://www.omg.org/spec/BPMN/2.0.2/PDF> ;
    bpmn:checkedBy bpmnsh:MessageFlowSamePoolShape .

bpmn:statement-06 a bpmn:NormativeStatement ;
    bpmn:clause "7.2.1 Uses of BPMN; also 10.2.1.1 Private (Internal) Business Processes"@en ;
    bpmn:page "21; 147-148"@en ;
    bpmn:verbatim "The Process flow is therefore contained within the Pool and cannot cross the boundaries of the Pool. The flow of Messages can cross the Pool boundary to show the interactions that exist between separate private Business Processes."@en ;
    dct:source <https://www.omg.org/spec/BPMN/2.0.2/PDF> ;
    bpmn:checkedBy bpmnsh:SequenceFlowContainerShape .

bpmn:statement-07 a bpmn:NormativeStatement ;
    bpmn:clause "8.4.1 Artifacts, Artifact Sequence Flow Connections"@en ;
    bpmn:page "65"@en ;
    bpmn:verbatim "An Artifact MUST NOT be a target for a Sequence Flow."@en ;
    dct:source <https://www.omg.org/spec/BPMN/2.0.2/PDF> ;
    bpmn:checkedBy bpmnsh:MatrixNoCellShape .

bpmn:statement-08 a bpmn:NormativeStatement ;
    bpmn:clause "8.4.1 Artifacts, Artifact Sequence Flow Connections"@en ;
    bpmn:page "65"@en ;
    bpmn:verbatim "An Artifact MUST NOT be a source for a Sequence Flow."@en ;
    dct:source <https://www.omg.org/spec/BPMN/2.0.2/PDF> ;
    bpmn:checkedBy bpmnsh:MatrixNoCellShape .

bpmn:statement-09 a bpmn:NormativeStatement ;
    bpmn:clause "8.4.1 Artifacts, Artifact Message Flow Connections"@en ;
    bpmn:page "65"@en ;
    bpmn:verbatim "An Artifact MUST NOT be a target for a Message Flow."@en ;
    dct:source <https://www.omg.org/spec/BPMN/2.0.2/PDF> ;
    bpmn:checkedBy bpmnsh:MatrixNoCellShape .

bpmn:statement-10 a bpmn:NormativeStatement ;
    bpmn:clause "8.4.1 Artifacts, Artifact Message Flow Connections"@en ;
    bpmn:page "65"@en ;
    bpmn:verbatim "An Artifact MUST NOT be a source for a Message Flow."@en ;
    dct:source <https://www.omg.org/spec/BPMN/2.0.2/PDF> ;
    bpmn:checkedBy bpmnsh:MatrixNoCellShape .

bpmn:statement-11 a bpmn:NormativeStatement ;
    bpmn:clause "8.4.13 Sequence Flow"@en ;
    bpmn:page "95"@en ;
    bpmn:verbatim "Each Sequence Flow has only one source and only one target. The source and target MUST be from the set of the following Flow Elements: Events (Start, Intermediate, and End), Activities (Task and Sub-Process; for Processes), Choreography Activities (Choreography Task and Sub-Choreography; for Choreographies), and Gateways."@en ;
    dct:source <https://www.omg.org/spec/BPMN/2.0.2/PDF> ;
    bpmn:checkedBy bpmnsh:FlowEndsShape ;
    bpmn:checkedBy bpmnsh:MatrixNoCellShape .

bpmn:statement-12 a bpmn:NormativeStatement ;
    bpmn:clause "8.4.13 Sequence Flow"@en ;
    bpmn:page "95"@en ;
    bpmn:verbatim "If a conditional Sequence Flow is used from a source Activity, then there MUST be at least one other outgoing Sequence Flow from that Activity."@en ;
    dct:source <https://www.omg.org/spec/BPMN/2.0.2/PDF> ;
    bpmn:checkedBy bpmnsh:ConditionalFromActivityShape .

bpmn:statement-13 a bpmn:NormativeStatement ;
    bpmn:clause "8.4.13 Sequence Flow"@en ;
    bpmn:page "95"@en ;
    bpmn:verbatim "A source Gateway MUST NOT be of type Parallel or Event."@en ;
    dct:source <https://www.omg.org/spec/BPMN/2.0.2/PDF> ;
    bpmn:checkedBy bpmnsh:ConditionFromGatewayShape .

bpmn:statement-14 a bpmn:NormativeStatement ;
    bpmn:clause "9.4 Message Flow"@en ;
    bpmn:page "119"@en ;
    bpmn:verbatim "A Message Flow MUST connect two separate Pools. They connect either to the Pool boundary or to Flow Objects within the Pool boundary. They MUST NOT connect two objects within the same Pool."@en ;
    dct:source <https://www.omg.org/spec/BPMN/2.0.2/PDF> ;
    bpmn:checkedBy bpmnsh:MessageFlowSamePoolShape .

bpmn:statement-15 a bpmn:NormativeStatement ;
    bpmn:clause "10.3 Activities, Sequence Flow Connections"@en ;
    bpmn:page "151"@en ;
    bpmn:verbatim "An Activity MAY be a target for Sequence Flows; it can have multiple incoming Sequence Flows."@en ;
    dct:source <https://www.omg.org/spec/BPMN/2.0.2/PDF> ;
    bpmn:notCheckedBecause "A permission (MAY): encoded as permitted cells in bpmn-matrix.ttl; there is nothing to violate."@en .

bpmn:statement-16 a bpmn:NormativeStatement ;
    bpmn:clause "10.3 Activities, Sequence Flow Connections"@en ;
    bpmn:page "151"@en ;
    bpmn:verbatim "An Activity MAY be a source for Sequence Flows; it can have multiple outgoing Sequence Flows."@en ;
    dct:source <https://www.omg.org/spec/BPMN/2.0.2/PDF> ;
    bpmn:notCheckedBecause "A permission (MAY): encoded as permitted cells in bpmn-matrix.ttl; there is nothing to violate."@en .

bpmn:statement-17 a bpmn:NormativeStatement ;
    bpmn:clause "10.3 Activities, Message Flow Connections"@en ;
    bpmn:page "152"@en ;
    bpmn:verbatim "NOTE: All Message Flows MUST connect two separate Pools. They MAY connect to the Pool boundary or to Flow Objects within the Pool boundary. They MUST NOT connect two objects within the same Pool."@en ;
    dct:source <https://www.omg.org/spec/BPMN/2.0.2/PDF> ;
    bpmn:checkedBy bpmnsh:MessageFlowSamePoolShape .

bpmn:statement-18 a bpmn:NormativeStatement ;
    bpmn:clause "10.3 Activities, Message Flow Connections"@en ;
    bpmn:page "152"@en ;
    bpmn:verbatim "An Activity MAY be the target of a Message Flow; it can have zero (0) or more incoming Message Flows."@en ;
    dct:source <https://www.omg.org/spec/BPMN/2.0.2/PDF> ;
    bpmn:notCheckedBecause "A permission (MAY): encoded as permitted cells in bpmn-matrix.ttl; there is nothing to violate."@en .

bpmn:statement-19 a bpmn:NormativeStatement ;
    bpmn:clause "10.3 Activities, Message Flow Connections"@en ;
    bpmn:page "152"@en ;
    bpmn:verbatim "An Activity MAY be a source of a Message Flow; it can have zero (0) or more outgoing Message Flows."@en ;
    dct:source <https://www.omg.org/spec/BPMN/2.0.2/PDF> ;
    bpmn:notCheckedBecause "A permission (MAY): encoded as permitted cells in bpmn-matrix.ttl; there is nothing to violate."@en .

bpmn:statement-20 a bpmn:NormativeStatement ;
    bpmn:clause "10.3.5 Sub-Processes (Event Sub-Process)"@en ;
    bpmn:page "174"@en ;
    bpmn:verbatim "An Event Sub-Process MUST NOT have any incoming or outgoing Sequence Flows."@en ;
    dct:source <https://www.omg.org/spec/BPMN/2.0.2/PDF> ;
    bpmn:checkedBy bpmnsh:EventSubProcessShape .

bpmn:statement-21 a bpmn:NormativeStatement ;
    bpmn:clause "10.5.2 Start Event, Sequence Flow Connections"@en ;
    bpmn:page "244"@en ;
    bpmn:verbatim "A Start Event MUST NOT be a target for Sequence Flows; it MUST NOT have incoming Sequence Flows."@en ;
    dct:source <https://www.omg.org/spec/BPMN/2.0.2/PDF> ;
    bpmn:checkedBy bpmnsh:MatrixForbiddenShape .

bpmn:statement-22 a bpmn:NormativeStatement ;
    bpmn:clause "10.5.2 Start Event, Sequence Flow Connections"@en ;
    bpmn:page "244"@en ;
    bpmn:verbatim "An exception to this is when a Start Event is used in an Expanded Sub-Process and is attached to the boundary of that Sub-Process. In this case, a Sequence Flow from the higher-level Process MAY connect to that Start Event in lieu of connecting to the actual boundary of the Sub-Process."@en ;
    dct:source <https://www.omg.org/spec/BPMN/2.0.2/PDF> ;
    bpmn:notCheckedBecause "Depends on where a shape sits in the diagram (diagram interchange), which stays in the XML."@en .

bpmn:statement-23 a bpmn:NormativeStatement ;
    bpmn:clause "10.5.2 Start Event, Sequence Flow Connections"@en ;
    bpmn:page "244"@en ;
    bpmn:verbatim "A Start Event MUST be a source for a Sequence Flow."@en ;
    dct:source <https://www.omg.org/spec/BPMN/2.0.2/PDF> ;
    bpmn:checkedBy bpmnsh:StartEventSourceShape .

bpmn:statement-24 a bpmn:NormativeStatement ;
    bpmn:clause "10.5.2 Start Event, Sequence Flow Connections"@en ;
    bpmn:page "244"@en ;
    bpmn:verbatim "The conditionExpression attribute for all outgoing Sequence Flows MUST be set to None."@en ;
    dct:source <https://www.omg.org/spec/BPMN/2.0.2/PDF> ;
    bpmn:checkedBy bpmnsh:StartEventConditionShape .

bpmn:statement-25 a bpmn:NormativeStatement ;
    bpmn:clause "10.5.2 Start Event, Message Flow Connections"@en ;
    bpmn:page "245"@en ;
    bpmn:verbatim "A Start Event MAY be the target for a Message Flow; it can have zero (0) or more incoming Message Flows."@en ;
    dct:source <https://www.omg.org/spec/BPMN/2.0.2/PDF> ;
    bpmn:notCheckedBecause "A permission (MAY): encoded as permitted cells in bpmn-matrix.ttl; there is nothing to violate."@en .

bpmn:statement-26 a bpmn:NormativeStatement ;
    bpmn:clause "10.5.2 Start Event, Message Flow Connections"@en ;
    bpmn:page "245"@en ;
    bpmn:verbatim "A Start Event MUST NOT be a source for a Message Flow; it MUST NOT have outgoing Message Flows."@en ;
    dct:source <https://www.omg.org/spec/BPMN/2.0.2/PDF> ;
    bpmn:checkedBy bpmnsh:MatrixNoCellShape .

bpmn:statement-27 a bpmn:NormativeStatement ;
    bpmn:clause "10.5.3 End Event, Sequence Flow Connections"@en ;
    bpmn:page "248"@en ;
    bpmn:verbatim "An End Event MUST be a target for a Sequence Flow."@en ;
    dct:source <https://www.omg.org/spec/BPMN/2.0.2/PDF> ;
    bpmn:checkedBy bpmnsh:EndEventTargetShape .

bpmn:statement-28 a bpmn:NormativeStatement ;
    bpmn:clause "10.5.3 End Event, Sequence Flow Connections"@en ;
    bpmn:page "248"@en ;
    bpmn:verbatim "An End Event MUST NOT be a source for Sequence Flows; that is, there MUST NOT be outgoing Sequence Flows."@en ;
    dct:source <https://www.omg.org/spec/BPMN/2.0.2/PDF> ;
    bpmn:checkedBy bpmnsh:MatrixForbiddenShape .

bpmn:statement-29 a bpmn:NormativeStatement ;
    bpmn:clause "10.5.3 End Event, Sequence Flow Connections"@en ;
    bpmn:page "248"@en ;
    bpmn:verbatim "An exception to this is when an End Event is used in an Expanded Sub-Process and is attached to the boundary of that Sub-Process. In this case, a Sequence Flow from the higher-level Process MAY connect from that End Event in lieu of connecting from the actual boundary of the Sub-Process."@en ;
    dct:source <https://www.omg.org/spec/BPMN/2.0.2/PDF> ;
    bpmn:notCheckedBecause "Depends on where a shape sits in the diagram (diagram interchange), which stays in the XML."@en .

bpmn:statement-30 a bpmn:NormativeStatement ;
    bpmn:clause "10.5.3 End Event, Message Flow Connections"@en ;
    bpmn:page "248"@en ;
    bpmn:verbatim "An End Event MUST NOT be the target of a Message Flow; it can have no incoming Message Flows."@en ;
    dct:source <https://www.omg.org/spec/BPMN/2.0.2/PDF> ;
    bpmn:checkedBy bpmnsh:MatrixNoCellShape .

bpmn:statement-31 a bpmn:NormativeStatement ;
    bpmn:clause "10.5.3 End Event, Message Flow Connections"@en ;
    bpmn:page "248"@en ;
    bpmn:verbatim "An End Event MAY be the source of a Message Flow; it can have zero (0) or more outgoing Message Flows."@en ;
    dct:source <https://www.omg.org/spec/BPMN/2.0.2/PDF> ;
    bpmn:notCheckedBecause "A permission (MAY): encoded as permitted cells in bpmn-matrix.ttl; there is nothing to violate."@en .

bpmn:statement-32 a bpmn:NormativeStatement ;
    bpmn:clause "10.5.3 End Event, Message Flow Connections"@en ;
    bpmn:page "248"@en ;
    bpmn:verbatim "The Result attribute of the End Event MUST be set to Message or Multiple if there are any outgoing Message Flows."@en ;
    dct:source <https://www.omg.org/spec/BPMN/2.0.2/PDF> ;
    bpmn:checkedBy bpmnsh:MatrixNoCellShape .

bpmn:statement-33 a bpmn:NormativeStatement ;
    bpmn:clause "10.5.4 Intermediate Event, Sequence Flow Connections"@en ;
    bpmn:page "258"@en ;
    bpmn:verbatim "If the Intermediate Event is attached to the boundary of an Activity: The Intermediate Event MUST NOT be a target for a Sequence Flow; it cannot have an incoming Sequence Flows."@en ;
    dct:source <https://www.omg.org/spec/BPMN/2.0.2/PDF> ;
    bpmn:checkedBy bpmnsh:BoundaryEventIncomingShape .

bpmn:statement-34 a bpmn:NormativeStatement ;
    bpmn:clause "10.5.4 Intermediate Event, Sequence Flow Connections"@en ;
    bpmn:page "258"@en ;
    bpmn:verbatim "The Intermediate Event MUST be a source for a Sequence Flow."@en ;
    dct:source <https://www.omg.org/spec/BPMN/2.0.2/PDF> ;
    bpmn:checkedBy bpmnsh:BoundaryEventSourceShape .

bpmn:statement-35 a bpmn:NormativeStatement ;
    bpmn:clause "10.5.4 Intermediate Event, Sequence Flow Connections"@en ;
    bpmn:page "258"@en ;
    bpmn:verbatim "An exception to this: an Intermediate Event with a Compensation trigger MUST NOT have an outgoing Sequence Flow (it MAY have an outgoing Association)."@en ;
    dct:source <https://www.omg.org/spec/BPMN/2.0.2/PDF> ;
    bpmn:checkedBy bpmnsh:CompensationOutgoingShape .

bpmn:statement-36 a bpmn:NormativeStatement ;
    bpmn:clause "10.5.4 Intermediate Event, Sequence Flow Connections"@en ;
    bpmn:page "258"@en ;
    bpmn:verbatim "The Intermediate Events with the following triggers (EventDefinition) MAY be used in normal flow: None, Message, Timer, Escalation, Compensation, Conditional, Link, Signal, Multiple, and ParallelMultiple. Thus, the following MUST NOT: Cancel and Error."@en ;
    dct:source <https://www.omg.org/spec/BPMN/2.0.2/PDF> ;
    bpmn:notCheckedBecause "A permission (MAY): encoded as permitted cells in bpmn-matrix.ttl; there is nothing to violate."@en .

bpmn:statement-37 a bpmn:NormativeStatement ;
    bpmn:clause "10.5.4 Intermediate Event, Sequence Flow Connections"@en ;
    bpmn:page "258"@en ;
    bpmn:verbatim "If the Intermediate Event is used within normal flow: Intermediate Events MUST be a target of a Sequence Flow. NOTE: This is a change from BPMN 1.2 semantics, which allowed some Intermediate Events to not have an incoming Sequence Flow."@en ;
    dct:source <https://www.omg.org/spec/BPMN/2.0.2/PDF> ;
    bpmn:checkedBy bpmnsh:IntermediateInFlowShape .

bpmn:statement-38 a bpmn:NormativeStatement ;
    bpmn:clause "10.5.4 Intermediate Event, Sequence Flow Connections"@en ;
    bpmn:page "258"@en ;
    bpmn:verbatim "An Intermediate Event MUST be a source for a Sequence Flow."@en ;
    dct:source <https://www.omg.org/spec/BPMN/2.0.2/PDF> ;
    bpmn:checkedBy bpmnsh:IntermediateInFlowShape .

bpmn:statement-39 a bpmn:NormativeStatement ;
    bpmn:clause "10.5.4 Intermediate Event, Sequence Flow Connections"@en ;
    bpmn:page "258"@en ;
    bpmn:verbatim "An exception to this: a source Link Intermediate Event (as defined below), it is NOT REQUIRED to have an outgoing Sequence Flow."@en ;
    dct:source <https://www.omg.org/spec/BPMN/2.0.2/PDF> ;
    bpmn:checkedBy bpmnsh:IntermediateInFlowShape .

bpmn:statement-40 a bpmn:NormativeStatement ;
    bpmn:clause "10.5.4 Intermediate Event, Sequence Flow Connections"@en ;
    bpmn:page "258"@en ;
    bpmn:verbatim "A Link Intermediate Event MUST NOT be both a target and a source of a Sequence Flow."@en ;
    dct:source <https://www.omg.org/spec/BPMN/2.0.2/PDF> ;
    bpmn:checkedBy bpmnsh:LinkBothWaysShape .

bpmn:statement-41 a bpmn:NormativeStatement ;
    bpmn:clause "10.5.4 Intermediate Event, Sequence Flow Connections"@en ;
    bpmn:page "258"@en ;
    bpmn:verbatim "A Link Intermediate Event MAY be the target (target Link) or a source (source Link) of a Sequence Flow, but MUST NOT be both a target and a source."@en ;
    dct:source <https://www.omg.org/spec/BPMN/2.0.2/PDF> ;
    bpmn:checkedBy bpmnsh:LinkBothWaysShape .

bpmn:statement-42 a bpmn:NormativeStatement ;
    bpmn:clause "10.5.4 Intermediate Event, Sequence Flow Connections"@en ;
    bpmn:page "258"@en ;
    bpmn:verbatim "If there is a source Link, there MUST be a matching target Link (they have the same name)."@en ;
    dct:source <https://www.omg.org/spec/BPMN/2.0.2/PDF> ;
    bpmn:checkedBy bpmnsh:LinkPairShape .

bpmn:statement-43 a bpmn:NormativeStatement ;
    bpmn:clause "10.5.4 Intermediate Event, Sequence Flow Connections"@en ;
    bpmn:page "258"@en ;
    bpmn:verbatim "There MAY be multiple source Links for a single target Link."@en ;
    dct:source <https://www.omg.org/spec/BPMN/2.0.2/PDF> ;
    bpmn:notCheckedBecause "A permission (MAY): encoded as permitted cells in bpmn-matrix.ttl; there is nothing to violate."@en .

bpmn:statement-44 a bpmn:NormativeStatement ;
    bpmn:clause "10.5.4 Intermediate Event, Sequence Flow Connections"@en ;
    bpmn:page "258"@en ;
    bpmn:verbatim "There MUST NOT be multiple target Links for a single source Link."@en ;
    dct:source <https://www.omg.org/spec/BPMN/2.0.2/PDF> ;
    bpmn:checkedBy bpmnsh:LinkSingleTargetShape .

bpmn:statement-45 a bpmn:NormativeStatement ;
    bpmn:clause "10.5.4 Intermediate Event, Message Flow Connections"@en ;
    bpmn:page "259"@en ;
    bpmn:verbatim "A Message Intermediate Event MAY be the target for a Message Flow; it can have one incoming Message Flow."@en ;
    dct:source <https://www.omg.org/spec/BPMN/2.0.2/PDF> ;
    bpmn:notCheckedBecause "A permission (MAY): encoded as permitted cells in bpmn-matrix.ttl; there is nothing to violate."@en .

bpmn:statement-46 a bpmn:NormativeStatement ;
    bpmn:clause "10.5.4 Intermediate Event, Message Flow Connections"@en ;
    bpmn:page "259"@en ;
    bpmn:verbatim "A Message Intermediate Event MAY be a source for a Message Flow; it can have one outgoing Message Flow."@en ;
    dct:source <https://www.omg.org/spec/BPMN/2.0.2/PDF> ;
    bpmn:notCheckedBecause "A permission (MAY): encoded as permitted cells in bpmn-matrix.ttl; there is nothing to violate."@en .

bpmn:statement-47 a bpmn:NormativeStatement ;
    bpmn:clause "10.5.4 Intermediate Event, Message Flow Connections"@en ;
    bpmn:page "259"@en ;
    bpmn:verbatim "A Message Intermediate Event MAY have an incoming Message Flow or an outgoing Message Flow, but not both."@en ;
    dct:source <https://www.omg.org/spec/BPMN/2.0.2/PDF> ;
    bpmn:checkedBy bpmnsh:MessageEventOneWayShape .

bpmn:statement-48 a bpmn:NormativeStatement ;
    bpmn:clause "10.6.1 Gateway, Sequence Flow Connections"@en ;
    bpmn:page "288"@en ;
    bpmn:verbatim "A Gateway MAY be a target for a Sequence Flow. It can have zero (0), one (1), or more incoming Sequence Flows."@en ;
    dct:source <https://www.omg.org/spec/BPMN/2.0.2/PDF> ;
    bpmn:notCheckedBecause "A permission (MAY): encoded as permitted cells in bpmn-matrix.ttl; there is nothing to violate."@en .

bpmn:statement-49 a bpmn:NormativeStatement ;
    bpmn:clause "10.6.1 Gateway, Sequence Flow Connections"@en ;
    bpmn:page "289"@en ;
    bpmn:verbatim "A Gateway MAY be a source of a Sequence Flow; it can have zero, one, or more outgoing Sequence Flows."@en ;
    dct:source <https://www.omg.org/spec/BPMN/2.0.2/PDF> ;
    bpmn:notCheckedBecause "A permission (MAY): encoded as permitted cells in bpmn-matrix.ttl; there is nothing to violate."@en .

bpmn:statement-50 a bpmn:NormativeStatement ;
    bpmn:clause "10.6.1 Gateway, Sequence Flow Connections"@en ;
    bpmn:page "289"@en ;
    bpmn:verbatim "A Gateway MUST have either multiple incoming Sequence Flows or multiple outgoing Sequence Flows (i.e., it MUST merge or split the flow)."@en ;
    dct:source <https://www.omg.org/spec/BPMN/2.0.2/PDF> ;
    bpmn:checkedBy bpmnsh:GatewaySplitsOrMergesShape .

bpmn:statement-51 a bpmn:NormativeStatement ;
    bpmn:clause "10.6.1 Gateway, Sequence Flow Connections"@en ;
    bpmn:page "289"@en ;
    bpmn:verbatim "A Gateway with a gatewayDirection of converging MUST have multiple incoming Sequence Flows, but MUST NOT have multiple outgoing Sequence Flows."@en ;
    dct:source <https://www.omg.org/spec/BPMN/2.0.2/PDF> ;
    bpmn:checkedBy bpmnsh:GatewayDirectionShape .

bpmn:statement-52 a bpmn:NormativeStatement ;
    bpmn:clause "10.6.1 Gateway, Sequence Flow Connections"@en ;
    bpmn:page "289"@en ;
    bpmn:verbatim "A Gateway with a gatewayDirection of diverging MUST have multiple outgoing Sequence Flows, but MUST NOT have multiple incoming Sequence Flows."@en ;
    dct:source <https://www.omg.org/spec/BPMN/2.0.2/PDF> ;
    bpmn:checkedBy bpmnsh:GatewayDirectionShape .

bpmn:statement-53 a bpmn:NormativeStatement ;
    bpmn:clause "10.6.6 Event-Based Gateway"@en ;
    bpmn:page "296"@en ;
    bpmn:verbatim "An Event Gateway MUST have two or more outgoing Sequence Flows."@en ;
    dct:source <https://www.omg.org/spec/BPMN/2.0.2/PDF> ;
    bpmn:checkedBy bpmnsh:EventGatewayShape .

bpmn:statement-54 a bpmn:NormativeStatement ;
    bpmn:clause "10.6.6 Event-Based Gateway"@en ;
    bpmn:page "296"@en ;
    bpmn:verbatim "The outgoing Sequence Flows of the Event Gateway MUST NOT have a conditionExpression."@en ;
    dct:source <https://www.omg.org/spec/BPMN/2.0.2/PDF> ;
    bpmn:checkedBy bpmnsh:ConditionFromGatewayShape .

bpmn:statement-55 a bpmn:NormativeStatement ;
    bpmn:clause "10.6.6 Event-Based Gateway"@en ;
    bpmn:page "297"@en ;
    bpmn:verbatim "Event-Based Gateways are configured by having outgoing Sequence Flows target an Intermediate Event or a Receive Task in any combination (see Figure 10.116 and Figure 10.117) except that:"@en ;
    dct:source <https://www.omg.org/spec/BPMN/2.0.2/PDF> ;
    bpmn:checkedBy bpmnsh:EventGatewayTargetShape .

bpmn:statement-56 a bpmn:NormativeStatement ;
    bpmn:clause "10.6.6 Event-Based Gateway"@en ;
    bpmn:page "297"@en ;
    bpmn:verbatim "If Message Intermediate Events are used in the configuration, then Receive Tasks MUST NOT be used in that configuration and vice versa."@en ;
    dct:source <https://www.omg.org/spec/BPMN/2.0.2/PDF> ;
    bpmn:checkedBy bpmnsh:EventGatewayMixShape .

bpmn:statement-57 a bpmn:NormativeStatement ;
    bpmn:clause "10.6.6 Event-Based Gateway"@en ;
    bpmn:page "297"@en ;
    bpmn:verbatim "Receive Tasks used in an Event Gateway configuration MUST NOT have any attached Intermediate Events."@en ;
    dct:source <https://www.omg.org/spec/BPMN/2.0.2/PDF> ;
    bpmn:checkedBy bpmnsh:EventGatewayReceiveTaskShape .

bpmn:statement-58 a bpmn:NormativeStatement ;
    bpmn:clause "10.6.6 Event-Based Gateway"@en ;
    bpmn:page "297"@en ;
    bpmn:verbatim "Only the following Intermediate Event triggers are valid: Message, Signal, Timer, Conditional, and Multiple (which can only include the previous triggers). Thus, the following Intermediate Event triggers are not valid: Error, Cancel, Compensation, and Link."@en ;
    dct:source <https://www.omg.org/spec/BPMN/2.0.2/PDF> ;
    bpmn:checkedBy bpmnsh:EventGatewayTargetShape .

bpmn:statement-59 a bpmn:NormativeStatement ;
    bpmn:clause "10.6.6 Event-Based Gateway"@en ;
    bpmn:page "297"@en ;
    bpmn:verbatim "Target elements in an Event Gateway configuration MUST NOT have any additional incoming Sequence Flows (other than that from the Event Gateway)."@en ;
    dct:source <https://www.omg.org/spec/BPMN/2.0.2/PDF> ;
    bpmn:checkedBy bpmnsh:EventGatewayTargetShape .
